# Normalize text line endings
* text=auto

# Unity YAML: merge as text, keep LF-friendly
*.unity      text merge=unityyamlmerge eol=lf
*.prefab     text merge=unityyamlmerge eol=lf
*.asset      text merge=unityyamlmerge eol=lf
*.mat        text merge=unityyamlmerge eol=lf
*.anim       text merge=unityyamlmerge eol=lf
*.controller text merge=unityyamlmerge eol=lf
*.meta       text merge=unityyamlmerge eol=lf
*.cs         text diff=csharp
*.shader     text
*.hlsl       text
*.json       text
*.md         text

# Binary assets
*.fbx   binary
*.blend binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.psd   binary
*.wav   binary
*.mp3   binary
*.ogg   binary
*.mp4   binary
*.ttf   binary
*.otf   binary
*.wlt   binary
